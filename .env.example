# ── Anthropic (default) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6     # optional override

# ── MiniMax ───────────────────────────────────────────────────────────────────
# LLM_PROVIDER=minimax
# MINIMAX_API_KEY=your-key
# MINIMAX_API_HOST=https://api.minimaxi.com   # or https://api.minimax.io (overseas)
# MINIMAX_TEXT_MODEL=MiniMax-M2.7

# ── SimpleTex OCR ─────────────────────────────────────────────────────────────
# Set both keys to enable SimpleTex as a selectable converter in the UI.
# When LLM_PROVIDER is also set, SimpleTex delegates auto-fix to the LLM.
# SIMPLETEX_APP_ID=your-app-id
# SIMPLETEX_APP_SECRET=your-app-secret
# SIMPLETEX_API_HOST=https://server.simpletex.cn   # optional override
# LLM_PROVIDER=simpletex                           # use SimpleTex as default

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=8000     # host port mapped in docker-compose
